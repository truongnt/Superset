{
  "name": "superset-plugin-chart-hello-world",
  "version": "0.1.0",
  "private": true,
  "description": "Scaffold project for developing an Apache Superset chart plugin",
  "sideEffects": false,
  "main": "lib/index.js",
  "module": "esm/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "esm",
    "lib"
  ],
  "scripts": {
    "clean": "rimraf lib esm tsconfig.tsbuildinfo",
    "build": "npm run clean && npm run build-cjs && npm run build-esm && npm run ts-types",
    "build-cjs": "babel src --extensions \".ts,.tsx,.js,.jsx\" --copy-files --out-dir lib",
    "build-esm": "cross-env BABEL_OUTPUT=esm babel src --extensions \".ts,.tsx,.js,.jsx\" --copy-files --out-dir esm",
    "dev": "cross-env BABEL_OUTPUT=esm babel src --extensions \".ts,.tsx,.js,.jsx\" --watch --copy-files --out-dir esm",
    "ts-types": "tsc --build"
  },
  "keywords": [
    "superset",
    "superset-plugin",
    "chart-plugin"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@superset-ui/chart-controls": "*",
    "@superset-ui/core": "*",
    "react": "^17.0.2",
    "react-dom": "^17.0.2"
  },
  "devDependencies": {
    "@superset-ui/chart-controls": "^0.20.3",
    "@superset-ui/core": "^0.20.4",
    "@airbnb/config-babel": "^3.1.0",
    "@babel/cli": "^7.28.0",
    "@babel/core": "^7.28.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@types/react": "^17.0.83",
    "babel-plugin-typescript-to-proptypes": "^2.1.0",
    "cross-env": "^10.0.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3"
  }
}
